.bv-root {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
}
.bv-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx 4rpx;
}
.bv-title { font-size: 28rpx; color: var(--gold); letter-spacing: 4rpx; }
.bv-timer { font-size: 26rpx; color: var(--text-dim); }
.bv-timer.danger { color: var(--red-hi); animation: glowPulse 0.8s infinite; }

.bv-field {
  position: relative;
  width: 750rpx;
  height: 960rpx;
  overflow: hidden;
}
.bv-flash {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at 50% 45%, rgba(255, 220, 150, 0.55), rgba(255, 120, 60, 0.25) 60%, transparent);
  animation: ultFlash 0.5s ease-out forwards;
  z-index: 30;
  pointer-events: none;
}
.bv-midline {
  position: absolute;
  left: 40rpx; right: 40rpx; top: 466rpx;
  border-top: 1rpx dashed rgba(217, 169, 78, 0.35);
  display: flex;
  justify-content: center;
}
.bv-vs {
  position: relative;
  top: -20rpx;
  background: var(--bg);
  color: rgba(217, 169, 78, 0.55);
  font-size: 24rpx;
  letter-spacing: 12rpx;
  padding: 0 20rpx;
}

/* ---- 单元 ---- */
.bunit {
  position: absolute;
  width: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}
.bunit.side-B { z-index: 9; }
.bunit.boss .bunit-face { transform: scale(1.14); }
.bunit.dead { opacity: 0.22; filter: grayscale(1); }
.bunit-crown {
  position: absolute;
  top: -26rpx; left: 6rpx;
  font-size: 30rpx;
  z-index: 12;
}
.bunit-status {
  position: absolute;
  top: -26rpx; right: 6rpx;
  display: flex;
  gap: 6rpx;
  z-index: 12;
}
.st {
  font-size: 22rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.65);
  border: 1rpx solid var(--line-hi);
}
.st-shield { color: #8ec5f0; }
.st-cc { color: #f0c964; }
.bunit-face {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image:
    radial-gradient(80rpx 50rpx at 50% 25%, rgba(255,255,255,0.14), transparent 70%),
    repeating-linear-gradient(-45deg, rgba(0,0,0,0.14) 0 8rpx, transparent 8rpx 16rpx);
  box-shadow: 0 6rpx 14rpx rgba(0,0,0,0.5);
}
.bunit-surname {
  font-size: 58rpx;
  font-weight: bold;
  color: rgba(255, 246, 224, 0.96);
  text-shadow: 0 3rpx 8rpx rgba(0,0,0,0.75);
}
.bunit-hpbar {
  width: 150rpx;
  height: 12rpx;
  margin-top: 8rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 999rpx;
  border: 1rpx solid rgba(90, 69, 42, 0.9);
  position: relative;
  overflow: hidden;
}
.bunit-hpbar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3f9e5f, #7fe08a);
  transition: width 0.15s;
}
.side-B .bunit-hpbar-in { background: linear-gradient(90deg, #b03a26, #e86a4a); }
.bunit-shieldbar {
  position: absolute;
  left: 0; top: 0;
  height: 100%;
  background: rgba(142, 197, 240, 0.75);
  border-radius: 999rpx;
}
.bunit-mpbar {
  width: 150rpx;
  height: 8rpx;
  margin-top: 4rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 999rpx;
  overflow: hidden;
}
.bunit-mpbar-in {
  height: 100%;
  background: linear-gradient(90deg, #b8842e, #f0cf8a);
  transition: width 0.15s;
}
.bunit-name {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.side-A .bunit-name { color: #cdb27f; }

/* ---- 大招横幅 ---- */
.bv-banner {
  position: absolute;
  left: 0; right: 0;
  top: 430rpx;
  display: flex;
  justify-content: center;
  z-index: 40;
  pointer-events: none;
}
.bv-banner-in {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 50rpx;
  background: linear-gradient(90deg, transparent, rgba(20, 12, 5, 0.92) 18%, rgba(20, 12, 5, 0.92) 82%, transparent);
  border-top: 1rpx solid rgba(240, 207, 138, 0.7);
  border-bottom: 1rpx solid rgba(240, 207, 138, 0.7);
  animation: bannerIn 1.1s ease-out forwards;
}
@keyframes bannerIn {
  0% { opacity: 0; transform: scale(0.7); letter-spacing: 0; }
  18% { opacity: 1; transform: scale(1.06); }
  30% { transform: scale(1); }
  80% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-14rpx); }
}
.bv-banner-who { font-size: 24rpx; color: var(--text-dim); letter-spacing: 6rpx; }
.bv-banner-in.side-B .bv-banner-who { color: #e89078; }
.bv-banner-in.side-A .bv-banner-who { color: #8fd8ae; }
.bv-banner-skill {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--gold-hi);
  letter-spacing: 10rpx;
  text-shadow: 0 0 24rpx rgba(240, 207, 138, 0.65);
}

/* ---- 底部控制 ---- */
.bv-ctrl {
  display: flex;
  justify-content: center;
  gap: 22rpx;
  padding: 8rpx 0 16rpx;
}
