.hcard {
  position: relative;
  background: linear-gradient(180deg, rgba(58, 42, 24, 0.9), rgba(34, 24, 16, 0.95));
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
  transition: transform 0.12s;
}
.hcard:active { transform: scale(0.96); }

.hcard-top { position: relative; }
.hcard-face {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  background-image:
    radial-gradient(140rpx 90rpx at 50% 20%, rgba(255,255,255,0.12), transparent 70%),
    repeating-linear-gradient(-45deg, rgba(0,0,0,0.12) 0 10rpx, transparent 10rpx 20rpx);
}
.hcard-surname {
  font-size: 88rpx;
  font-weight: bold;
  color: rgba(255, 245, 220, 0.95);
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.7), 0 0 24rpx rgba(255,255,255,0.25);
}
.hcard-tags {
  position: absolute;
  left: 10rpx; top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.hcard-mark {
  position: absolute;
  right: 8rpx; top: 8rpx;
  background: linear-gradient(180deg, #d4553a, #96291a);
  color: #ffe8d8;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e88a6a;
}
.hcard-body { padding: 12rpx 14rpx 16rpx; }
.hcard-name { font-size: 30rpx; font-weight: bold; color: var(--text); }
.hcard-title { font-size: 20rpx; margin-top: 2rpx; }
.hcard-stars { margin-top: 4rpx; font-size: 20rpx; line-height: 1; }
.star { color: rgba(120, 100, 70, 0.5); }
.star.s1 { color: rgba(200, 170, 110, 0.4); }
.star.s2 { color: #f0c964; text-shadow: 0 0 8rpx rgba(240, 201, 100, 0.7); }
.hcard-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* row 模式：横向 */
.hcard.row { display: flex; align-items: center; padding: 14rpx; gap: 16rpx; }
.hcard.row .hcard-top { width: 110rpx; flex-shrink: 0; }
.hcard.row .hcard-face { height: 110rpx; border-radius: 10rpx; }
.hcard.row .hcard-surname { font-size: 60rpx; }
.hcard.row .hcard-tags { left: 4rpx; top: 4rpx; }
.hcard.row .hcard-body { flex: 1; padding: 0; }

/* mini 模式：紧凑方形 */
.hcard.mini .hcard-face { height: 100rpx; }
.hcard.mini .hcard-surname { font-size: 56rpx; }
.hcard.mini .hcard-body { padding: 6rpx 10rpx 10rpx; }
.hcard.mini .hcard-title { display: none; }
