.tabbar {
  display: flex;
  background: linear-gradient(180deg, #241a10, #171009);
  border-top: 1rpx solid #5a452a;
  padding-bottom: env(safe-area-inset-bottom);
  position: relative;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  position: relative;
  color: #a6906c;
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1.2;
  filter: grayscale(0.6);
  transition: all 0.2s;
}
.tab-text {
  font-size: 22rpx;
  margin-top: 4rpx;
  letter-spacing: 4rpx;
}
.tab-item.active {
  color: #e9c47a;
}
.tab-item.active .tab-icon {
  filter: none;
  transform: translateY(-4rpx) scale(1.12);
  text-shadow: 0 0 16rpx rgba(240, 207, 138, 0.8);
}
.tab-glow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, transparent, #f0cf8a, transparent);
}
