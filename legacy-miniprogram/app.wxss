/* ===== 三国远征 全局设计系统 ===== */
page {
  --bg: #171009;
  --panel-hi: #2e2113;
  --panel-lo: #221810;
  --line: #5a452a;
  --line-hi: #8a6a33;
  --gold: #d9a94e;
  --gold-hi: #f0cf8a;
  --gold-deep: #b8842e;
  --text: #e9d8b4;
  --text-dim: #a6906c;
  --red: #c74a32;
  --red-hi: #e86a4a;
  --green: #4a9e78;
  --blue: #4d7fb5;
  --purple: #9a6ed0;

  background-color: var(--bg);
  background-image:
    radial-gradient(1200rpx 600rpx at 50% -10%, rgba(217, 169, 78, 0.07), transparent 60%),
    repeating-linear-gradient(45deg, rgba(255,255,255,0.012) 0 6rpx, transparent 6rpx 12rpx);
  color: var(--text);
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---- 面板 ---- */
.panel {
  background: linear-gradient(180deg, var(--panel-hi), var(--panel-lo));
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  position: relative;
}
.panel-ornate {
  border: 1rpx solid var(--line-hi);
  box-shadow: 0 0 0 1rpx rgba(0,0,0,0.4), inset 0 0 40rpx rgba(0,0,0,0.35);
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  padding: 16rpx 30rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  border: 1rpx solid var(--line-hi);
  background: linear-gradient(180deg, #3a2b18, #2b1f11);
  color: var(--text);
  text-align: center;
}
.btn::after { border: none; }
.btn-gold {
  background: linear-gradient(180deg, #f0cd7c, #c08a3e);
  border-color: #f4dd9e;
  color: #3a2408;
  font-weight: bold;
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.3);
}
.btn-red {
  background: linear-gradient(180deg, #d4553a, #96291a);
  border-color: #e88a6a;
  color: #ffe8d8;
  font-weight: bold;
}
.btn-ghost {
  background: rgba(217,169,78,0.06);
  border: 1rpx solid var(--line-hi);
  color: var(--gold);
}
.btn-disabled {
  filter: grayscale(0.9) brightness(0.6);
  pointer-events: none;
}
.btn-sm { padding: 8rpx 20rpx; font-size: 24rpx; border-radius: 10rpx; }

/* ---- 文本 ---- */
.t-gold { color: var(--gold); }
.t-dim { color: var(--text-dim); }
.t-red { color: var(--red-hi); }
.t-green { color: var(--green); }
.h-title {
  font-size: 34rpx;
  color: var(--gold-hi);
  letter-spacing: 6rpx;
  font-weight: bold;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--gold);
  letter-spacing: 4rpx;
  margin: 24rpx 8rpx 14rpx;
}
.section-title::before {
  content: "";
  width: 8rpx; height: 26rpx;
  background: linear-gradient(180deg, var(--gold-hi), var(--gold-deep));
  margin-right: 12rpx;
  border-radius: 4rpx;
}
.section-title::after {
  content: "";
  flex: 1; height: 1rpx;
  background: linear-gradient(90deg, var(--line), transparent);
  margin-left: 16rpx;
}

/* ---- 阵营色 ---- */
.f-wei { color: #7fb0e8; }
.f-shu { color: #6cc79a; }
.f-wu { color: #f08a6a; }
.f-qun { color: #c39af0; }
.bg-wei { background: rgba(77,127,181,0.22); }
.bg-shu { background: rgba(74,158,120,0.22); }
.bg-wu { background: rgba(199,74,50,0.22); }
.bg-qun { background: rgba(154,110,208,0.22); }

/* ---- 品质 ---- */
.r1 { color: #9db8d8; }
.r2 { color: #c99af0; }
.r3 { color: #f0b95e; }
.rarity-frame-1 { border-color: #5a7fa8; box-shadow: 0 0 12rpx rgba(90,127,168,0.35); }
.rarity-frame-2 { border-color: #9a6ed0; box-shadow: 0 0 12rpx rgba(154,110,208,0.4); }
.rarity-frame-3 { border-color: #e8a33d; box-shadow: 0 0 16rpx rgba(232,163,61,0.45); }

/* ---- 通用小件 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  border: 1rpx solid var(--line);
  background: rgba(0,0,0,0.25);
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  border: 1rpx solid var(--line);
  background: rgba(0,0,0,0.3);
}
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--line), transparent);
  margin: 16rpx 0;
}

/* ---- 顶栏货币 ---- */
.res-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  padding: 16rpx 24rpx 8rpx;
}
.res-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0,0,0,0.45);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
  color: var(--gold-hi);
}

/* ---- 弹窗 ---- */
.modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.72);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  width: 620rpx;
  max-width: 92vw;
  background: linear-gradient(180deg, #322413, #241a10);
  border: 1rpx solid var(--line-hi);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.6);
}
.modal-title {
  text-align: center;
  font-size: 34rpx;
  color: var(--gold-hi);
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

/* ---- 进度条 ---- */
.bar {
  height: 14rpx;
  background: rgba(0,0,0,0.55);
  border: 1rpx solid rgba(90,69,42,0.8);
  border-radius: 999rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4a9e78, #7fd0a8);
}
.bar-fill.gold { background: linear-gradient(90deg, #b8842e, #f0cd7c); }
.bar-fill.red { background: linear-gradient(90deg, #a33420, #e86a4a); }
.bar-fill.blue { background: linear-gradient(90deg, #3b6ea5, #7fb0e8); }

/* ---- 浮动数字动画 ---- */
@keyframes floatUp {
  0% { transform: translateY(0) scale(0.8); opacity: 0; }
  15% { opacity: 1; transform: translateY(-10rpx) scale(1.15); }
  100% { transform: translateY(-110rpx) scale(1); opacity: 0; }
}
.float-num {
  position: absolute;
  font-weight: bold;
  font-size: 30rpx;
  animation: floatUp 0.9s ease-out forwards;
  pointer-events: none;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.9);
  z-index: 20;
  white-space: nowrap;
}
.float-dmg { color: #ffb84d; }
.float-crit { color: #ff5a3c; font-size: 38rpx; }
.float-heal { color: #7fe0a8; }
.float-shield { color: #8ec5f0; }
.float-dot { color: #c98af0; font-size: 26rpx; }

@keyframes shake {
  0%,100% { transform: translate(0,0); }
  20% { transform: translate(-8rpx, 4rpx); }
  40% { transform: translate(8rpx, -4rpx); }
  60% { transform: translate(-6rpx, -2rpx); }
  80% { transform: translate(6rpx, 2rpx); }
}
.shake { animation: shake 0.3s ease-in-out; }

@keyframes lungeUp {
  0%,100% { transform: translateY(0); }
  40% { transform: translateY(-26rpx); }
}
.lunge-up { animation: lungeUp 0.32s ease-out; }
@keyframes lungeDown {
  0%,100% { transform: translateY(0); }
  40% { transform: translateY(26rpx); }
}
.lunge-down { animation: lungeDown 0.32s ease-out; }

@keyframes ultFlash {
  0% { opacity: 0; }
  10% { opacity: 1; }
  100% { opacity: 0; }
}
@keyframes glowPulse {
  0%,100% { box-shadow: 0 0 12rpx rgba(240,207,138,0.5); }
  50% { box-shadow: 0 0 34rpx rgba(240,207,138,0.95); }
}
.ult-glow { animation: glowPulse 0.8s ease-in-out infinite; }

.empty-tip {
  text-align: center;
  color: var(--text-dim);
  padding: 60rpx 0;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
