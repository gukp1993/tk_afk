<view class="page">
  <battle-view id="bv" bind:finish="onFinish" bind:retreat="onRetreat" />

  <!-- 结算浮层 -->
  <view class="result-mask" wx:if="{{over}}">
    <view class="result-box modal-box">
      <view class="result-title {{win ? 'win' : 'lose'}}">{{win ? '凯 旋' : '败 北'}}</view>
      <view class="result-sub t-dim" wx:if="{{skipped}}">（跳过战斗，直接结算）</view>
      <view class="result-lines">
        <view wx:for="{{resultLines}}" wx:key="*this" class="result-line">{{item}}</view>
      </view>
      <view class="result-btns">
        <view class="btn btn-ghost" bindtap="onExit">返回</view>
        <view class="btn btn-ghost" bindtap="retry">再战</view>
        <view class="btn btn-gold {{nextLabel ? '' : 'btn-disabled'}}" bindtap="onNext">{{nextLabel || '已至当前尽头'}}</view>
      </view>
    </view>
  </view>
</view>
