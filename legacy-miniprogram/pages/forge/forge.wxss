.page { padding: 0 24rpx 40rpx; }
.filters { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 16rpx 0; }
.fchip.chip-on { border-color: var(--gold); color: var(--gold-hi); background: rgba(217, 169, 78, 0.14); }

.list { display: flex; flex-direction: column; gap: 14rpx; }
.item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; gap: 14rpx; }
.item-title { font-size: 28rpx; display: flex; align-items: center; gap: 10rpx; }
.item-icon { font-size: 34rpx; }
.item-stat { font-size: 22rpx; margin-top: 6rpx; }
.item-ops { display: flex; flex-direction: column; gap: 10rpx; }
.item-ops .btn { min-width: 150rpx; font-size: 22rpx; }

.hero-scroll { max-height: 52vh; }
.hero-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.hero-cell { width: calc((100% - 24rpx) / 3); }

.toast {
  position: fixed;
  left: 50%; bottom: 200rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.85);
  border: 1rpx solid var(--line-hi);
  color: var(--gold-hi);
  padding: 14rpx 34rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 200;
}
