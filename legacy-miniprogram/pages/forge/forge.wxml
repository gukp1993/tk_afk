<view class="page">
  <view class="res-bar">
    <view class="res-chip">🪙 {{goldText}}</view>
  </view>

  <view class="filters">
    <view
      wx:for="{{filters}}" wx:key="key"
      class="chip fchip {{filter === item.key ? 'chip-on' : ''}}"
      data-key="{{item.key}}" bindtap="setFilter"
    >{{item.name}}</view>
  </view>

  <view class="list">
    <view class="item panel" wx:for="{{list}}" wx:key="id">
      <view class="item-main">
        <view class="item-title">
          <text class="item-icon" style="color: {{item.color}};">{{item.icon}}</text>
          <text style="color: {{item.color}}; font-weight: bold;">{{item.tierName}} {{item.slotName}}</text>
          <text wx:if="{{item.enh > 0}}" class="t-gold">+{{item.enh}}</text>
        </view>
        <view class="t-dim item-stat">{{item.statText}}</view>
      </view>
      <view class="item-ops">
        <view class="btn btn-sm {{item.maxed ? 'btn-disabled' : 'btn-gold'}}" data-id="{{item.id}}" bindtap="enhance">
          {{item.maxed ? '已满' : '强化 ' + item.nextCost}}
        </view>
        <view class="btn btn-sm btn-ghost" data-id="{{item.id}}" bindtap="openWear">穿戴</view>
        <view class="btn btn-sm btn-ghost" data-id="{{item.id}}" bindtap="salvage">分解 {{item.salvage}}</view>
      </view>
    </view>
  </view>
  <view class="empty-tip" wx:if="{{!list.length}}">背包空空如也 · 出征战役可获装备</view>

  <!-- 选择武将穿戴 -->
  <popup show="{{showHero}}" title="穿 戴 给 谁" bind:close="closeHero">
    <scroll-view scroll-y class="hero-scroll">
      <view class="hero-grid">
        <view class="hero-cell" wx:for="{{heroes}}" wx:key="id">
          <hero-card hero="{{item}}" mode="mini" bind:cardtap="pickHero" />
        </view>
      </view>
    </scroll-view>
  </popup>

  <view class="toast" wx:if="{{toast}}">{{toast}}</view>
</view>
