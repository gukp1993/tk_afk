.page { padding: 24rpx; }
.me { display: flex; justify-content: space-between; padding: 26rpx; }
.me-rank { font-size: 32rpx; margin: 8rpx 0 4rpx; }
.me-right { text-align: right; font-size: 22rpx; }
.me-power { font-size: 34rpx; }
.me-edit { margin-top: 6rpx; text-decoration: underline; }

.opps { display: flex; flex-direction: column; gap: 16rpx; }
.opp { padding: 20rpx 24rpx; }
.opp-hard { border-color: #a05a3a; }
.opp-head { display: flex; justify-content: space-between; align-items: center; }
.opp-name { font-size: 30rpx; color: var(--gold); letter-spacing: 2rpx; }
.opp-info { font-size: 22rpx; margin: 8rpx 0 14rpx; }
.opp-btn { align-self: flex-start; }
.hint { font-size: 22rpx; margin-top: 10rpx; }
