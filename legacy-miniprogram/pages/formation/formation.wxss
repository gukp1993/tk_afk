.page { padding: 24rpx; }
.top { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; }
.top-power { font-size: 34rpx; margin-top: 8rpx; }
.top-bonus { font-size: 22rpx; margin-top: 4rpx; }

.field { margin-top: 24rpx; padding: 24rpx 0; }
.row-label { text-align: center; font-size: 22rpx; letter-spacing: 6rpx; margin-bottom: 14rpx; }
.frow { display: flex; justify-content: center; gap: 24rpx; }
.frow-line {
  height: 1rpx;
  margin: 26rpx 60rpx;
  background: linear-gradient(90deg, transparent, var(--line), transparent);
}
.fslot { width: 190rpx; text-align: center; }
.fface {
  height: 150rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 76rpx;
  font-weight: bold;
  color: rgba(255, 246, 224, 0.96);
  text-shadow: 0 3rpx 10rpx rgba(0,0,0,0.7);
}
.fslot:active .fface { transform: scale(0.95); }
.fempty { border-style: dashed; color: var(--text-dim); font-size: 50rpx; }
.fname { font-size: 26rpx; margin-top: 8rpx; }
.flv { font-size: 20rpx; }

.hint { font-size: 22rpx; margin-top: 10rpx; text-align: center; }

.empty-btn { margin-bottom: 16rpx; }
.pick-scroll { max-height: 52vh; }
.pick-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pick-cell { width: calc((100% - 24rpx) / 3); }

.toast {
  position: fixed;
  left: 50%; bottom: 200rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.85);
  border: 1rpx solid var(--line-hi);
  color: var(--gold-hi);
  padding: 14rpx 34rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 200;
}
