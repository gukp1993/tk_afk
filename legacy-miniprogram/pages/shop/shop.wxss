.page { padding: 0 24rpx 40rpx; }
.goods { display: flex; flex-direction: column; gap: 14rpx; }
.good { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; gap: 16rpx; }
.good.soldout { opacity: 0.45; }
.good-name { font-size: 28rpx; display: flex; align-items: center; gap: 10rpx; }
.good-limit { font-size: 20rpx; margin-top: 4rpx; }
.good .btn { min-width: 170rpx; font-size: 24rpx; }
.hint { font-size: 22rpx; margin-top: 10rpx; }

.pick-scroll { max-height: 56vh; }
.pick-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pick-cell { width: calc((100% - 24rpx) / 3); }

.toast {
  position: fixed;
  left: 50%; bottom: 200rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.85);
  border: 1rpx solid var(--line-hi);
  color: var(--gold-hi);
  padding: 14rpx 34rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 200;
}
