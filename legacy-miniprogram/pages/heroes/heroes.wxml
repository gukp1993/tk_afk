<view class="page">
  <view class="res-bar">
    <view class="res-chip">🪙 {{resView.gold}}</view>
    <view class="res-chip">💵 {{resView.gem}}</view>
    <view class="res-chip">📜 {{resView.scroll}}</view>
    <view class="res-chip">📕 {{resView.exp}}</view>
  </view>

  <!-- 共鸣水晶 -->
  <view class="crystal panel">
    <view class="crystal-head">
      <view class="h-title">共鸣水镜</view>
      <view class="t-dim">已聚 {{crystal.count}} 名武将</view>
    </view>
    <view class="crystal-body">
      <text class="t-gold">共鸣等级 Lv.{{crystal.cap}}</text>
      <text class="t-dim"> — 等级前五的武将定下全军共鸣之境，其余武将自动共享此等级。</text>
    </view>
  </view>

  <!-- 筛选 -->
  <view class="filters">
    <view
      wx:for="{{filters}}" wx:key="key"
      class="chip fchip {{filter === item.key ? 'chip-on' : ''}}"
      data-key="{{item.key}}" bindtap="setFilter"
    >{{item.name}}</view>
    <view class="fspace"></view>
    <view
      wx:for="{{sorts}}" wx:key="key"
      class="chip fchip {{sort === item.key ? 'chip-on' : ''}}"
      data-key="{{item.key}}" bindtap="setSort"
    >{{item.name}}↓</view>
  </view>

  <!-- 列表 -->
  <view class="grid">
    <view class="gcell" wx:for="{{heroes}}" wx:key="id">
      <hero-card hero="{{item}}" mode="grid" marked="{{item.isTop5 ? '共鸣' : ''}}" bind:cardtap="onCardTap" />
    </view>
  </view>
  <view class="empty-tip" wx:if="{{!heroes.length}}">尚无武将，前往点将台招募</view>
</view>
