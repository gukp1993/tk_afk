.page { padding: 0 24rpx 40rpx; }

.crystal { margin-top: 12rpx; padding: 20rpx 24rpx; }
.crystal-head { display: flex; justify-content: space-between; align-items: baseline; }
.crystal-body { margin-top: 10rpx; font-size: 24rpx; line-height: 1.7; }

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0 16rpx;
}
.fchip.chip-on {
  border-color: var(--gold);
  color: var(--gold-hi);
  background: rgba(217, 169, 78, 0.14);
}
.fspace { flex: 1; }

.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.gcell { width: calc((100% - 32rpx) / 3); }
