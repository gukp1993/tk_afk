.page { padding: 0 24rpx 40rpx; }

.stage { margin-top: 16rpx; overflow: hidden; }
.stage-art {
  position: relative;
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(500rpx 240rpx at 50% 88%, rgba(240, 201, 100, 0.22), transparent 70%),
    repeating-conic-gradient(from 0deg at 50% 120%, rgba(217, 169, 78, 0.06) 0deg 12deg, transparent 12deg 24deg),
    linear-gradient(180deg, #2e2113, #221810);
}
.stage-glow {
  position: absolute;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(240, 207, 138, 0.35);
  box-shadow: 0 0 60rpx rgba(240, 207, 138, 0.28), inset 0 0 40rpx rgba(240, 207, 138, 0.18);
  animation: glowPulse 2.4s ease-in-out infinite;
}
.stage-title {
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 20rpx;
  color: var(--gold-hi);
  text-shadow: 0 0 30rpx rgba(240, 207, 138, 0.6);
}
.stage-sub { margin-top: 8rpx; font-size: 24rpx; letter-spacing: 6rpx; }
.stage-coin {
  margin-top: 18rpx;
  font-size: 44rpx;
  color: var(--gold);
  animation: coinSpin 6s linear infinite;
}
@keyframes coinSpin {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(360deg); }
}
.stage-rates { padding: 14rpx; text-align: center; font-size: 22rpx; }

.pity { margin-top: 20rpx; padding: 20rpx 24rpx; }
.pity-row { display: flex; align-items: center; font-size: 22rpx; }

.pulls { display: flex; gap: 16rpx; margin-top: 24rpx; }
.pull-btn { flex: 1.4; flex-direction: column; padding: 22rpx 10rpx; gap: 8rpx; }
.pull-btn:first-child { flex: 1; }
.pull-t { font-size: 30rpx; letter-spacing: 4rpx; }
.pull-c { font-size: 20rpx; }

/* 结果弹层 */
.result-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(8, 4, 2, 0.92);
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-inner { width: 100%; display: flex; flex-direction: column; align-items: center; }
.result-title {
  font-size: 36rpx;
  letter-spacing: 12rpx;
  color: var(--gold-hi);
  margin-bottom: 40rpx;
  text-shadow: 0 0 26rpx rgba(240, 207, 138, 0.6);
}
.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  width: 690rpx;
}
.pcard {
  position: relative;
  width: 200rpx; height: 260rpx;
  perspective: 600rpx;
}
.pcard-back {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx;
  color: rgba(240, 207, 138, 0.8);
  background:
    repeating-linear-gradient(45deg, rgba(217,169,78,0.15) 0 10rpx, transparent 10rpx 20rpx),
    linear-gradient(180deg, #3a2b18, #241a10);
  border: 2rpx solid var(--line-hi);
  border-radius: 16rpx;
  backface-visibility: hidden;
  transition: all 0.45s;
}
.pcard-face {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  transform: rotateY(180deg);
  backface-visibility: hidden;
  transition: all 0.45s;
}
.pcard.revealed .pcard-back { transform: rotateY(180deg); opacity: 0; }
.pcard.revealed .pcard-face { transform: rotateY(0deg); }
.pcard-name { font-size: 34rpx; font-weight: bold; color: #fff6e0; }
.pcard-rar { font-size: 26rpx; font-weight: bold; }
.pcard-new {
  position: absolute; top: 8rpx; right: 8rpx;
  background: linear-gradient(180deg, #f0cd7c, #c08a3e);
  color: #3a2408;
  font-size: 18rpx; font-weight: bold;
  padding: 2rpx 10rpx; border-radius: 8rpx;
}
.pcard-dup {
  position: absolute; top: 8rpx; right: 8rpx;
  background: rgba(0,0,0,0.6);
  color: var(--text-dim);
  font-size: 18rpx;
  padding: 2rpx 10rpx; border-radius: 8rpx;
  border: 1rpx solid var(--line);
}
/* 品质光效 */
.pcard.rar3.revealed .pcard-face {
  border-color: #f0b95e;
  box-shadow: 0 0 40rpx rgba(240, 185, 94, 0.65), inset 0 0 30rpx rgba(240, 185, 94, 0.25);
  animation: ssrPop 0.5s ease-out;
}
.pcard.rar2.revealed .pcard-face {
  border-color: #9a6ed0;
  box-shadow: 0 0 26rpx rgba(154, 110, 208, 0.5);
}
.pcard.rar1.revealed .pcard-face {
  border-color: #5a7fa8;
  box-shadow: 0 0 18rpx rgba(90, 127, 168, 0.45);
}
@keyframes ssrPop {
  0% { transform: scale(1.4) rotateY(0deg); }
  60% { transform: scale(0.95) rotateY(0deg); }
  100% { transform: scale(1) rotateY(0deg); }
}
.close-btn { margin-top: 44rpx; width: 320rpx; }

.toast {
  position: fixed;
  left: 50%; bottom: 220rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.85);
  border: 1rpx solid var(--line-hi);
  color: var(--gold-hi);
  padding: 14rpx 34rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 200;
}
